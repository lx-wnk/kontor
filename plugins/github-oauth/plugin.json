{
  "$schema": "../../plugin-sdk/plugin.schema.json",
  "contract": 1,
  "id": "github-oauth",
  "name": "GitHub OAuth",
  "version": "2.0.0",
  "capabilities": [
    "auth_provider"
  ],
  "addr": "127.0.0.1:19001",
  "command": [
    "./github-oauth"
  ],
  "env": [
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "DASHBOARD_URL",
    "DASHBOARD_AUTH_PLUGIN_SECRET"
  ]
}
