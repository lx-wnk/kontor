{
  "server": "imap-mcp-server",
  "version": "2.0.0",
  "match": "imap-mcp-server",
  "confirmed": true,
  "denyGlobal": [
    "imap_add_account",
    "imap_update_account",
    "imap_remove_account",
    "imap_send_email",
    "imap_reply_to_email",
    "imap_forward_email",
    "imap_delete_email",
    "imap_bulk_delete",
    "imap_bulk_delete_by_search",
    "imap_delete_spam",
    "imap_delete_by_domain",
    "imap_download_attachment",
    "imap_upload_file",
    "imap_add_spam_domain",
    "imap_remove_spam_domain",
    "imap_add_whitelist_domain"
  ],
  "setup": {
    "command": "npx",
    "args": ["-y", "-p", "imap-mcp-server@2.0.0", "imap-setup", "--no-open", "--skip-claude", "--port", "{port}"],
    "readiness": "/api/health"
  },
  "secretTemplates": [
    "IMAP_MCP_ACCOUNT_{ACCOUNT}_IMAP_PASSWORD",
    "IMAP_MCP_ACCOUNT_{ACCOUNT}_SMTP_PASSWORD"
  ]
}
